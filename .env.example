# URL pública do backend (sem barra no final). Ex.: http://192.168.0.10:8080 ou a URL do ngrok.
EXPO_PUBLIC_API_URL=

# Chave PÚBLICA de teste do Mercado Pago (somente a versão web usa). Nunca coloque o Access Token aqui.
EXPO_PUBLIC_MP_PUBLIC_KEY=

# Ambiente: development usa o checkout de sandbox.
EXPO_PUBLIC_APP_ENV=development
